        "def bin_tomato_runtime(x):\n",
        "    if x < 60:\n",
        "        return 'Under 60 min'\n",
        "    elif x < 90:\n",
        "        return '60–90 min'\n",
        "    elif x < 120:\n",
        "        return '90–120 min'\n",
        "    elif x < 150:\n",
        "        return '120–150 min'\n",
        "    elif x < 180:\n",
        "        return '150–180 min'\n",
        "    else:\n",
        "        return 'Over 180 min'\n",
        "\n",
        "# Apply binning\n",
        "tomato_df['runtime_bucket'] = tomato_df['runtime'].apply(bin_tomato_runtime)\n",
