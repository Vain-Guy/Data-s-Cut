        "rating_year_df = tomato_df[['release_year', 'maturity_rating', 'box_office']].dropna()\n",
        "rating_year_summary = (\n",
        "    rating_year_df\n",
        "    .groupby(['release_year', 'maturity_rating'])['box_office']\n",
        "    .sum()\n",
        "    .reset_index()\n",
        "    .sort_values(['maturity_rating', 'release_year'])\n",
        ")\n",
        "\n",
        "# Plot\n",
        "fig = px.line(\n",
